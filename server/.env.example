# ===== LeSacAEthique — configuration du serveur =====
# Copier en .env et adapter. NE JAMAIS versionner le fichier .env.

PUBLIC_URL=https://cer.promednav.fr          # adresse publique de l'application
PORT=8443
HOST=127.0.0.1                                # écoute locale derrière le proxy HTTPS (Caddy)
TRUST_PROXY=loopback

COMMITTEE_NAME=CER-PROMEDNAV
COMMITTEE_LONG_NAME=Comité d'éthique de la recherche de PROMEDNAV
REFERENCE_PREFIX=CER-PROMEDNAV               # références CER-PROMEDNAV-AAAA-NNN

# Données (base + documents chiffrés) et clés : idéalement sur deux volumes distincts,
# et les clés JAMAIS dans la même sauvegarde que les données.
DATA_DIR=/var/lib/lesacaethique/data
KEYS_DIR=/etc/lesacaethique/keys
# Facultatif : clé de chiffrement fournie par l'environnement (64 caractères hexadécimaux)
# DATA_ENCRYPTION_KEY=

# Site internet de l'association autorisé à déposer des demandes (séparées par des virgules)
PUBLIC_FORM_ORIGINS=https://www.promednav.com,https://promednav.com

# Courriel (notifications, invitations, réinitialisations)
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CER-PROMEDNAV <cer@promednav.com>
SECRETARIAT_EMAIL=cer@promednav.com

# Notifications push (facultatif) : générer avec « npx web-push generate-vapid-keys »
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cer@promednav.com

# Sécurité
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
INVITE_VALID_HOURS=72
RESET_VALID_MINUTES=30
MAX_UPLOAD_MB=25
MAX_FILES_PER_SUBMISSION=20
